<Window x:Class="TerrainForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:TerrainForge.ViewModels"
        Title="Simple Terrain Generator" Height="760" Width="1180" MinHeight="640" MinWidth="900"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22">
                    <TextBlock Text="Simple Terrain Generator" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,5" />
                    <TextBlock Text="Location" FontSize="13" Margin="0,0,0,6" />
                    <TextBox Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter a place name" />

                    <TextBlock Text="Area width and height (km)" FontSize="13" Margin="0,16,0,6" />
                    <TextBox Text="{Binding AreaSizeText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Generate terrain" Command="{Binding GenerateCommand}" HorizontalAlignment="Stretch" />
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding LoadingVisibility}">
                        <ProgressBar Height="3" IsIndeterminate="True" Foreground="#77766E" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Getting elevation data…" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="7,3" Background="#E7E6E1" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#A13B32" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="View" FontSize="13" Margin="0,24,0,6" />
                    <ComboBox SelectedValue="{Binding RenderMode}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Solid" Tag="{x:Static vm:RenderMode.Solid}" IsSelected="True" />
                        <ComboBoxItem Content="Wireframe" Tag="{x:Static vm:RenderMode.Wireframe}" />
                    </ComboBox>

                    <TextBlock Text="Terrain information" FontSize="15" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <TextBlock Text="{Binding LocationName}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CoordinatesText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="Minimum elevation" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding MinimumElevationText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="Maximum elevation" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding MaximumElevationText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="Elevation range" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding ElevationDifferenceText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="Area" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding AreaText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="Vertices" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding VertexCountText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="Triangles" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding TriangleCountText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="Average resolution" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding ResolutionText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="2,2,2,10">
                <TextBlock Text="Terrain preview" FontSize="14" FontWeight="SemiBold" />
            </DockPanel>

            <Border Grid.Row="1" Background="#E5E4DF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <h:HelixViewport3D x:Name="TerrainViewport" Background="#E5E4DF" ZoomExtentsWhenLoaded="True" ShowViewCube="False" CameraMode="Inspect" CameraRotationMode="Turntable" ZoomAroundMouseDownPoint="True">
                    <h:HelixViewport3D.Camera>
                        <PerspectiveCamera Position="6500,5200,7000" LookDirection="-6500,-4200,-7000" UpDirection="0,1,0" FieldOfView="45" />
                    </h:HelixViewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#777777" />
                                <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-1" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </h:HelixViewport3D>
            </Border>

            <DockPanel Grid.Row="2" Margin="2,9,2,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
